<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Чтобы видеть список всех установленных приложений с иконками -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Чтобы найти «Телефон» и «Камеру» для рабочего стола по умолчанию -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <!-- Для проверки и скачивания обновлений с GitHub -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Чтобы лаунчер мог установить скачанное обновление (Android спросит разрешение) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Проводник «Этот телефон» и папки на рабочем столе -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Установка движка Windows в фоне (уведомление с прогрессом) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- HOME: можно выбрать как рабочий стол телефона -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- LAUNCHER: иконка в меню, чтобы можно было попробовать без смены рабочего стола -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Окно «Этот телефон» (проводник): отдельная задача в «недавних» -->
        <activity
            android:name=".ExplorerActivity"
            android:exported="false"
            android:label="Этот телефон"
            android:launchMode="singleTask"
            android:taskAffinity="com.aleksos.launcher.explorer"
            android:theme="@style/AosWindow"
            android:windowSoftInputMode="adjustResize" />

        <!-- Отдаёт файлы другим приложениям при «Открыть» / «Отправить» -->
        <provider
            android:name=".FilesProvider"
            android:authorities="com.aleksos.launcher.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Скачивание и распаковка движка Windows -->
        <service
            android:name=".EngineInstallService"
            android:exported="false" />

        <!-- Ответ системного установщика при самообновлении -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
